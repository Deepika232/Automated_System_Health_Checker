CPU_THRESHOLD=80
MEM_THRESHOLD=80
DISK_THRESHOLD=80
HEALTH_REPORT_PATH=reports/health_report.txt
LOG_PATH=logs/app.log
SERVICE_NAMES=ssh,cron,docker

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
ALERT_TO=receiver_email@gmail.com
SMTP_USE_TLS=true

